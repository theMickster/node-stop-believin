									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Book retrieved matches created book\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('lifecycleBookId'));",
									"    pm.expect(jsonData.name).to.eql('1984');",
									"    pm.expect(jsonData.authors).to.have.lengthOf(1);",
									"});"
								],
								"type": "text/javascript"
							}
						}
