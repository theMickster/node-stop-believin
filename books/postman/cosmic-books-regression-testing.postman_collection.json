	"item": [
		{
			"name": "Complete Book Lifecycle",
			"description": "Tests the entire lifecycle: Create -> Update -> Publish -> Classify -> Update Publication -> Delete",
			"item": [
				{
					"name": "Setup - Create Test Book",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Book created successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData.name).to.eql('1984');",
									"    ",
									"    // Store for later tests",
									"    pm.collectionVariables.set('lifecycleBookId', jsonData.id);",
									"    pm.collectionVariables.set('lifecycleBookVersion', jsonData.version);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"1984\",\n    \"authors\": [\n        {\n            \"authorId\": \"{{$guid}}\",\n            \"firstName\": \"George\",\n            \"lastName\": \"Orwell\",\n            \"displayName\": \"George Orwell\",\n            \"role\": \"Author\",\n            \"order\": 1\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{cosmosReadApiUrl}}/api/books",
							"host": [
								"{{cosmosReadApiUrl}}"
							],
							"path": [
								"api",
								"books"
							]
						}
					},
					"response": []
				},
				{
					"name": "Verify Book Created",
					"event": [
						{
							"listen": "test",
							"script": {
