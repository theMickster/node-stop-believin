        },
        {
          "name": "Publish Book - With Both ISBNs",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Create a new book for this test",
                  "const createBookRequest = {",
                  "    url: pm.variables.get('cosmosReadApiUrl') + '/api/books',",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Content-Type': 'application/json'",
                  "    },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            name: 'To Kill a Mockingbird',",
                  "            authors: [{",
                  "                authorId: '6e85bd9a-8780-46eb-a65b-1481188c8cd3',",
                  "                firstName: 'Harper',",
                  "                lastName: 'Lee',",
                  "                displayName: 'Harper Lee',",
                  "                role: 'Author',",
                  "                order: 1",
                  "            }]",
                  "        })",
                  "    }",
                  "};",
                  "",
                  "pm.sendRequest(createBookRequest, (err, response) => {",
                  "    if (err) {",
                  "        console.error('Failed to create book:', err);",
                  "    } else {",
                  "        const bookData = response.json();",
                  "        pm.collectionVariables.set('publishBookId', bookData.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Book has both ISBN formats\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.isbn).to.have.property('isbn10');",
                  "    pm.expect(jsonData.isbn).to.have.property('isbn13');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
