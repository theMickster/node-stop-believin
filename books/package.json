{
  "name": "cosmic-books-api",
  "version": "1.0.0",
  "description": "A Node.js Express API for managing books with Azure Cosmos DB",
  "main": "dist/server.js",
  "scripts": {
    "start": "npm run build && NODE_ENV=production node dist/server.js",
    "dev": "pkill -f 'ts-node-dev.*books/src/server' || true && ts-node-dev --respawn --clear --transpile-only --ignore-watch node_modules --no-notify -r tsconfig-paths/register src/server.ts",
    "build": "rm -rf dist && tsc",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "type-check": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --coverage"
  },
  "_moduleAliases": {
    "@features": "dist/features",
    "@data": "dist/data",
    "@libs": "dist/libs",
    "@controllers": "dist/controllers",
    "@routes": "dist/routes",
    "@fixtures": "dist/_test_/fixtures",
    "@middleware": "dist/middleware"
  },
  "dependencies": {
    "@azure/cosmos": "^4.5.1",
    "@azure/identity": "^4.12.0",
    "@azure/monitor-opentelemetry": "^1.14.0",
    "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.32",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation-express": "^0.54.3",
    "@opentelemetry/instrumentation-http": "^0.205.0",
    "@opentelemetry/instrumentation-winston": "^0.50.2",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "body-parser": "^2.2.0",
    "dotenv-expand": "^12.0.3",
    "inversify": "^7.10.2",
    "joi": "^18.0.1",
    "module-alias": "^2.2.3",
    "passport": "^0.7.0",
    "passport-azure-ad": "^4.3.5",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "winston-azure-application-insights": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.1",
    "@types/passport": "^1.0.17",
    "@types/passport-azure-ad": "^4.3.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.2.3",
    "eslint": "^9.36.0",
    "express": "^5.1.0",
    "install": "^0.13.0",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "node-mocks-http": "^1.17.2",
    "npm": "^11.6.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
